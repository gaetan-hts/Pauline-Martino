---
import Layout from '../../../layouts/Layout.astro';
import { site } from '../../../data/site';
import { englishEnabled, legalPath } from '../../../i18n/config';

export function getStaticPaths() {
  return englishEnabled ? [{ params: { rest: undefined } }] : [];
}
---
<Layout lang="en" title="Legal notice | Pauline Martino" description="Legal notice and privacy policy for the website of Pauline Martino, hypnotherapist in La Farlède." campaign="en-legal" alternates={legalPath}>
  <section class="wrap max-w-3xl py-16">
    <h1 class="text-4xl">Legal notice and privacy</h1>
    <div class="prose-pauline mt-8 text-prune/85">
      <p><strong>Publisher:</strong> Pauline Martino, {site.address.street}, {site.address.postalCode} {site.address.city}, France. Phone: {site.phone}. Email: {site.email}.</p>
      <p><strong>SIRET:</strong> [to be completed]</p>
      <p><strong>Hosting:</strong> [to be completed with the chosen host, e.g. Cloudflare, Inc.]</p>
      <p><strong>Personal data:</strong> this website does not use advertising cookies. Information sent by email or phone is used only to answer your request. Bookings are handled by Medoucine, which has its own privacy policy.</p>
      <p>The French version of this notice is the authoritative one.</p>
    </div>
  </section>
</Layout>
