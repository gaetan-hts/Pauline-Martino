---
// Gabarit commun aux 7 pages thématiques (contenu dans src/content/accompagnements/)
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BookingButton from '../components/BookingButton.astro';
import Quote from '../components/Quote.astro';
import { site, quotes } from '../data/site';

export async function getStaticPaths() {
  const pages = await getCollection('accompagnements');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const d = page.data;
const others = (await getCollection('accompagnements'))
  .filter((p) => p.id !== page.id)
  .sort((a, b) => a.data.order - b.data.order);
const quote = quotes[(d.order + 1) % quotes.length];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: site.url },
    { '@type': 'ListItem', position: 2, name: d.menuLabel, item: `${site.url}/${page.id}` },
  ],
};
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${d.menuLabel} : hypnose et NEMO`,
  serviceType: 'Hypnothérapie',
  provider: { '@id': `${site.url}/#cabinet` },
  areaServed: [site.address.city, ...site.neighbours].map((name) => ({ '@type': 'City', name })),
  description: d.description,
};
---
<Layout title={d.seoTitle} description={d.description} campaign={page.id} jsonLd={[breadcrumb, service]} ogImage={d.image}>
  <section>
    <div class="wrap pt-6">
      <nav aria-label="Fil d’Ariane" class="text-sm text-noyer/65">
        <a href="/" class="hover:text-argile">Accueil</a>
        <span aria-hidden="true" class="mx-1.5">/</span>
        <a href="/#accompagnements" class="hover:text-argile">Accompagnements</a>
        <span aria-hidden="true" class="mx-1.5">/</span>
        <span aria-current="page">{d.menuLabel}</span>
      </nav>
    </div>
    <div class="wrap grid items-center gap-10 pt-8 pb-14 md:grid-cols-[1.15fr_0.85fr] md:gap-16 md:pb-20">
      <div>
        <p class="text-lg text-olive">{d.menuLabel} à La Farlède et en visio</p>
        <h1 class="mt-3 text-[2.3rem] sm:text-5xl">{d.title}</h1>
        <p class="mt-6 max-w-xl text-xl leading-relaxed text-noyer/85">{d.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <BookingButton campaign={`${page.id}-hero`} />
          <a class="btn btn-ghost" href={site.phoneHref}>Appeler le {site.phone}</a>
        </div>
      </div>
      <div class="arch mx-auto aspect-[4/5] w-full max-w-sm bg-lin-fonce md:max-w-none">
        <Image src={d.image} alt={d.imageAlt} widths={[400, 640, 900]} sizes="(min-width: 768px) 38vw, 90vw" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  {d.extra && (
    <section class="bg-lin-fonce py-14 sm:py-20">
      <div class="wrap max-w-3xl">
        <h2 class="text-3xl">{d.extra.title}</h2>
        <p class="mt-5 text-lg text-noyer/85">{d.extra.text}</p>
      </div>
    </section>
  )}

  <section class="py-14 sm:py-20">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <h2 class="text-3xl">Vous vous reconnaissez ?</h2>
        <ul class="mt-6 space-y-4">
          {d.signs.map((s) => (
            <li class="flex gap-4 text-lg text-noyer/90">
              <span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-argile" aria-hidden="true"></span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-3xl">Comment je vous accompagne</h2>
        <div class="prose-pauline mt-6 text-lg text-noyer/85">
          <Content />
        </div>
      </div>
    </div>
  </section>

  <section class="pb-14 sm:pb-20">
    <div class="wrap">
      <div class="grid gap-8 rounded-3xl bg-olive-nuit p-8 text-lin sm:p-12 md:grid-cols-[1.4fr_0.6fr] md:items-center">
        <div>
          <h2 class="text-3xl text-lin">En pratique</h2>
          <p class="mt-4 max-w-2xl text-lg text-lin/85">{d.practice}</p>
          <p class="mt-3 text-lin/70">Séance d’une heure, {site.price}.</p>
        </div>
        <div class="flex flex-col gap-3">
          <BookingButton campaign={`${page.id}-pratique`} />
          <a class="btn border border-lin/30 text-lin hover:bg-lin/10" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
      <p class="mt-6 text-sm text-noyer/65">{d.disclaimer}</p>
    </div>
  </section>

  <Quote {...quote} />

  <section class="py-14 sm:py-20">
    <div class="wrap">
      <h2 class="text-2xl sm:text-3xl">Les autres accompagnements</h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {others.map((p) => (
          <li><a href={`/${p.id}`} class="inline-block rounded-full border border-noyer/20 px-5 py-2.5 hover:border-argile hover:text-argile">{p.data.menuLabel}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
