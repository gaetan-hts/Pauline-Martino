---
// Pages thématiques en français : contenu dans src/content/accompagnements/
import ServicePage from '../components/pages/ServicePage.astro';
import { getServices } from '../data/services';

export async function getStaticPaths() {
  return (await getServices('fr')).map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
---
<ServicePage lang="fr" service={Astro.props.service} />
