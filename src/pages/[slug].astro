---
// Gabarit commun aux 7 pages thématiques (contenu dans src/content/accompagnements/)
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BookingButton from '../components/BookingButton.astro';
import Quote from '../components/Quote.astro';
import { site, quotes } from '../data/site';

export async function getStaticPaths() {
  const pages = await getCollection('accompagnements');
  return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const d = page.data;
const others = (await getCollection('accompagnements'))
  .filter((p) => p.id !== page.id)
  .sort((a, b) => a.data.order - b.data.order);
const quote = quotes[(d.order + 1) % quotes.length];

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Accompagnements', item: `${site.url}/#accompagnements` },
    { '@type': 'ListItem', position: 3, name: d.menuLabel, item: `${site.url}/${page.id}` },
  ],
};
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `${d.menuLabel} : hypnose et NEMO`,
  serviceType: 'Hypnothérapie',
  provider: { '@id': `${site.url}/#cabinet` },
  areaServed: [site.address.city, ...site.neighbours].map((name) => ({ '@type': 'City', name })),
  description: d.description,
  url: `${site.url}/${page.id}`,
  availableChannel: { '@type': 'ServiceChannel', name: 'Au cabinet à La Farlède ou en visio', serviceUrl: `${site.url}/${page.id}` },
  offers: { '@type': 'Offer', price: site.priceValue, priceCurrency: 'EUR', description: `Séance d’${site.duration}` },
};
---
<Layout title={d.seoTitle} description={d.description} campaign={page.id} jsonLd={[breadcrumb, service]} ogImage={d.image} ogImageAlt={d.imageAlt}>
  <section>
    <div class="wrap pt-6">
      <nav aria-label="Fil d’Ariane" class="text-sm text-noyer/65">
        <a href="/" class="hover:text-argile">Accueil</a>
        <span aria-hidden="true" class="mx-1.5">/</span>
        <a href="/#accompagnements" class="hover:text-argile">Accompagnements</a>
        <span aria-hidden="true" class="mx-1.5">/</span>
        <span aria-current="page">{d.menuLabel}</span>
      </nav>
    </div>
    <div class="wrap grid items-center gap-10 pt-8 pb-14 md:grid-cols-[1.15fr_0.85fr] md:gap-16 md:pb-20">
      <div>
        <p class="text-lg text-olive">{d.menuLabel} à La Farlède et en visio</p>
        <h1 class="mt-3 text-[2.3rem] sm:text-5xl">{d.title}</h1>
        <p class="mt-6 max-w-xl text-xl leading-relaxed text-noyer/85">{d.intro}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <BookingButton campaign={`${page.id}-hero`} />
          <a class="btn btn-ghost" href={site.phoneHref}>Appeler le {site.phone}</a>
        </div>
      </div>
      <div class="arch mx-auto aspect-[4/5] w-full max-w-sm bg-lin-fonce md:max-w-none">
        <Image src={d.image} alt={d.imageAlt} widths={[400, 640, 900]} sizes="(min-width: 768px) 38vw, 90vw" class="h-full w-full object-cover" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  {d.extra && (
    <section class="bg-lin-fonce py-14 sm:py-20">
      <div class="wrap max-w-3xl">
        <h2 class="text-3xl">{d.extra.title}</h2>
        <p class="mt-5 text-lg text-noyer/85">{d.extra.text}</p>
      </div>
    </section>
  )}

  <section class="py-14 sm:py-20">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <h2 class="text-3xl">Vous vous reconnaissez ?</h2>
        <ul class="mt-6 space-y-4">
          {d.signs.map((s) => (
            <li class="flex gap-4 text-lg text-noyer/90">
              <span class="mt-2.5 h-2 w-2 shrink-0 rounded-full bg-argile" aria-hidden="true"></span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-3xl">Comment je vous accompagne</h2>
        <div class="prose-pauline mt-6 text-lg text-noyer/85">
          <Content />
        </div>
      </div>
    </div>
  </section>

  <section class="pb-14 sm:pb-20">
    <div class="wrap">
      <div class="grid gap-8 rounded-3xl bg-olive-nuit p-8 text-lin sm:p-12 md:grid-cols-[1.4fr_0.6fr] md:items-center">
        <div>
          <h2 class="text-3xl text-lin">En pratique</h2>
          <p class="mt-4 max-w-2xl text-lg text-lin/85">{d.practice}</p>
          <p class="mt-3 text-lin/70">Séance d’une heure, {site.price}.</p>
        </div>
        <div class="flex flex-col gap-3">
          <BookingButton campaign={`${page.id}-pratique`} />
          <a class="btn border border-lin/30 text-lin hover:bg-lin/10" href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <Quote {...quote} />

  <!-- Maillage interne : les autres pages thématiques -->
  <section class="bg-lin-fonce py-16 sm:py-24">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl sm:text-4xl">Les autres accompagnements</h2>
          <p class="mt-3 max-w-xl text-noyer/75">Hypnose et NEMO à La Farlède et en visio, pour d’autres situations du quotidien.</p>
        </div>
        <a href="/#accompagnements" class="font-semibold text-olive underline underline-offset-4 hover:text-argile">Tous les accompagnements</a>
      </div>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((p) => (
          <li>
            <a href={`/${p.id}`} class="card group flex h-full flex-col overflow-hidden rounded-3xl border border-noyer/10 bg-lin">
              <div class="overflow-hidden">
                <Image src={p.data.image} alt="" widths={[360, 560]} sizes="(min-width: 1024px) 22rem, (min-width: 640px) 45vw, 90vw" class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-2xl transition-colors group-hover:text-argile">{p.data.menuLabel}</h3>
                <p class="mt-2 flex-1 text-noyer/75">{p.data.summary}</p>
                <span class="mt-5 inline-flex items-center gap-2 font-semibold text-olive">
                  Découvrir
                  <svg viewBox="0 0 24 24" class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
