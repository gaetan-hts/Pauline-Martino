---
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import OliveMark from './OliveMark.astro';
import BookingButton from './BookingButton.astro';
const pages = (await getCollection('accompagnements')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
---
<footer class="bg-olive-nuit text-lin/90">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-3">
        <OliveMark class="h-10 w-10 text-sauge" />
        <p class="font-serif text-2xl text-lin">Pauline Martino</p>
      </div>
      <p class="mt-4 max-w-sm">Hypnothérapeute et praticienne NEMO à La Farlède, à 15 minutes de Toulon. Séances au cabinet ou en visio.</p>
      <BookingButton campaign="footer" class="mt-6" />
    </div>

    <div>
      <h2 class="font-sans text-base font-semibold text-lin">Accompagnements</h2>
      <ul class="mt-4 space-y-2">
        {pages.map((p) => <li><a class="hover:text-argile-clair" href={`/${p.id}`}>{p.data.menuLabel}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="font-sans text-base font-semibold text-lin">Le cabinet</h2>
      <address class="mt-4 not-italic">
        {site.address.street}<br />{site.address.postalCode} {site.address.city}
      </address>
      <p class="mt-3"><a class="font-semibold hover:text-argile-clair" href={site.phoneHref}>{site.phone}</a></p>
      <p><a class="break-all hover:text-argile-clair" href={`mailto:${site.email}`}>{site.email}</a></p>
      <ul class="mt-4 flex gap-4">
        <li><a class="hover:text-argile-clair" href={site.social.instagram} rel="noopener" target="_blank">Instagram</a></li>
        <li><a class="hover:text-argile-clair" href={site.social.facebook} rel="noopener" target="_blank">Facebook</a></li>
        <li><a class="hover:text-argile-clair" href={site.social.linkedin} rel="noopener" target="_blank">LinkedIn</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-lin/15">
    <div class="wrap flex flex-col gap-2 py-6 text-sm text-lin/65 sm:flex-row sm:justify-between">
      <p>© {year} Pauline Martino. Les séances ne remplacent pas un suivi médical ou psychologique.</p>
      <p><a href="/mentions-legales" class="hover:text-lin">Mentions légales et confidentialité</a></p>
    </div>
  </div>
</footer>
