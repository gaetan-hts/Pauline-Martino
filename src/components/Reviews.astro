---
// Section avis de la home : une carte par plateforme (note + palier d'avis « 100+ ») et les avis
// choisis par Pauline (src/data/avis.ts). Pas de balisage AggregateRating.
import { platforms, reviews } from '../data/avis';
import { ui, dateLocale } from '../i18n/ui';
import type { Lang } from '../i18n/config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const u = ui[lang].reviews;
const loc = dateLocale[lang];
// « 2025 » ou « 2026-04 » → « 2025 » / « avril 2026 »
const fmtMonth = (d: string) => (d.length === 4 ? d : new Intl.DateTimeFormat(loc, { month: 'long', year: 'numeric' }).format(new Date(`${d}-15`)));
const fmtRating = (r: number) => r.toLocaleString(loc, { minimumFractionDigits: r % 1 ? 1 : 0 });
const star = 'M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z';
---
<section id="avis" class="bg-sable py-16 sm:py-24">
  <div class="wrap">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
      <div>
        <h2 class="text-3xl sm:text-4xl">{u.title}</h2>
        <p class="mt-4 max-w-md text-lg text-encre/80">{u.intro}</p>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2">
        {platforms.map((p) => (
          <li>
            <a href={p.url} target="_blank" rel="noopener" class="card group flex h-full flex-col rounded-3xl border border-encre/10 bg-creme p-7">
              <p class="text-sm font-semibold text-cuivre">{u.on(p.source)}</p>
              <p class="mt-3 flex items-baseline gap-2">
                <span class="font-serif text-5xl text-encre">{fmtRating(p.rating)}</span>
                <span class="text-encre/60">/ 5</span>
              </p>
              <span class="mt-2 flex gap-1 text-cuivre" role="img" aria-label={u.rating(p.rating)}>
                {[1, 2, 3, 4, 5].map((i) => (
                  <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
                    <path d={star} fill={i <= Math.round(p.rating) ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                  </svg>
                ))}
              </span>
              <p class="mt-4 font-semibold">{u.count(p.count)}</p>
              {p.note && lang === 'fr' && <p class="mt-1 text-sm text-encre/70">{p.note}</p>}
              <span class="mt-auto inline-flex items-center gap-2 pt-5 font-semibold text-cuivre group-hover:text-encre">
                {u.read}
                <svg viewBox="0 0 24 24" class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="sr-only">{u.newTab(p.source)}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    {u.originalLang && <p class="mt-12 text-sm text-encre/65">{u.originalLang}</p>}
    <ul class:list={['gap-5 md:columns-2 lg:columns-3', u.originalLang ? 'mt-4' : 'mt-12']}>
      {reviews.map((r) => (
        <li class="mb-5 break-inside-avoid rounded-3xl bg-creme p-7">
          <div class="flex items-center justify-between gap-4">
            <span class="rounded-full bg-sable px-3 py-1 text-sm text-cuivre">{r.topic[lang]}</span>
            <span class="flex gap-0.5 text-cuivre" role="img" aria-label={u.rating(5)}>
              {[1, 2, 3, 4, 5].map(() => (
                <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true"><path d={star} fill="currentColor" /></svg>
              ))}
            </span>
          </div>
          <blockquote lang="fr" class="mt-5 text-encre/85">
            <p>« {r.text.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)} »</p>
          </blockquote>
          <p class="mt-5 text-sm">
            <span class="font-semibold">{r.author}</span>
            <span class="text-encre/60"> · {u.verified(r.source)}, {fmtMonth(r.date)}</span>
          </p>
        </li>
      ))}
    </ul>

    <p class="mt-6 max-w-3xl text-sm text-encre/65">{u.selection}</p>
    <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
      {platforms.map((p) => (
        <a href={p.url} target="_blank" rel="noopener" class="font-semibold text-cuivre underline underline-offset-4 hover:text-encre">
          {u.seeAll(p.count, p.source)}<span class="sr-only"> {u.newTab(p.source)}</span>
        </a>
      ))}
    </div>
  </div>
</section>
