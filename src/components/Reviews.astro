---
// Section avis de la home : avis choisis par Pauline (src/data/avis.ts) + liens vers tous les avis.
// Pas de note ni de nombre d'avis (ils évoluent sans cesse), pas de balisage AggregateRating.
import { platforms, reviews } from '../data/avis';
import { ui, dateLocale } from '../i18n/ui';
import type { Lang } from '../i18n/config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const u = ui[lang].reviews;
// « 2025 » ou « 2026-04 » → « 2025 » / « avril 2026 »
const fmtMonth = (d: string) =>
  d.length === 4 ? d : new Intl.DateTimeFormat(dateLocale[lang], { month: 'long', year: 'numeric' }).format(new Date(`${d}-15`));
const star = 'M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z';
---
<section id="avis" class="bg-sable py-16 sm:py-24">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <h2 class="text-3xl sm:text-4xl">{u.title}</h2>
        <p class="mt-4 max-w-xl text-lg text-brun/80">{u.intro}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        {platforms.map((p) => (
          <a href={p.url} target="_blank" rel="noopener" class="btn btn-ghost">
            {u.seeAll(p.source)}<span class="sr-only"> {u.newTab(p.source)}</span>
          </a>
        ))}
      </div>
    </div>

    {u.originalLang && <p class="mt-10 text-sm text-brun/65">{u.originalLang}</p>}
    <ul class="mt-10 gap-5 md:columns-2 lg:columns-3">
      {reviews.map((r) => (
        <li class="mb-5 break-inside-avoid rounded-3xl bg-creme p-7">
          <div class="flex items-center justify-between gap-4">
            <span class="rounded-full bg-sable px-3 py-1 text-sm text-pivoine">{r.topic[lang]}</span>
            <span class="flex gap-0.5 text-soleil" role="img" aria-label={u.rating}>
              {[1, 2, 3, 4, 5].map(() => (
                <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true"><path d={star} fill="currentColor" /></svg>
              ))}
            </span>
          </div>
          <blockquote lang="fr" class="mt-5 text-brun/85">
            <p>« {r.text.split('\n').map((line, i) => <>{i > 0 && <br />}{line}</>)} »</p>
          </blockquote>
          <p class="mt-5 text-sm">
            <span class="font-semibold">{r.author}</span>
            <span class="text-brun/60"> · {u.verified(r.source)}, {fmtMonth(r.date)}</span>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
