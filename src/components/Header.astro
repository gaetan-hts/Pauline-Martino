---
import { site } from '../data/site';
import OliveMark from './OliveMark.astro';
import BookingButton from './BookingButton.astro';
interface Props { campaign: string }
const { campaign } = Astro.props;
const nav = [
  { href: '/#accompagnements', label: 'Accompagnements' },
  { href: '/#qui-suis-je', label: 'Qui suis-je' },
  { href: '/#techniques', label: 'Hypnose et NEMO' },
  { href: '/#infos-pratiques', label: 'Infos pratiques' },
  { href: '/#faq', label: 'Questions' },
];
---
<header class="sticky top-0 z-40 border-b border-noyer/10 bg-lin/95 backdrop-blur">
  <div class="wrap max-w-7xl! flex h-18 items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-2.5 text-noyer no-underline">
      <OliveMark class="h-9 w-9 text-olive" />
      <span class="leading-tight whitespace-nowrap">
        <span class="block font-serif text-lg">Pauline Martino</span>
        <span class="block text-xs text-noyer/70">Hypnothérapeute à La Farlède</span>
      </span>
    </a>

    <nav aria-label="Navigation principale" class="hidden xl:block">
      <ul class="flex gap-5 text-[0.95rem] whitespace-nowrap xl:gap-7">
        {nav.map((l) => <li><a class="hover:text-argile" href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={site.phoneHref} class="hidden font-semibold whitespace-nowrap text-olive hover:text-argile xl:inline">{site.phone}</a>
      <a href={site.phoneHref} class="grid h-11 w-11 place-items-center rounded-full border border-noyer/20 text-olive xl:hidden" aria-label={`Appeler le ${site.phone}`}>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" stroke-linejoin="round"/></svg>
      </a>
      <BookingButton campaign={`header-${campaign}`} label="Rendez-vous" class="hidden px-5! whitespace-nowrap sm:inline-flex" />
      <button type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-mobile" class="grid h-11 w-11 place-items-center rounded-full border border-noyer/20 xl:hidden">
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  <nav id="menu-mobile" aria-label="Navigation mobile" class="hidden border-t border-noyer/10 xl:hidden" data-menu>
    <ul class="wrap flex flex-col py-3">
      {nav.map((l) => <li><a class="block py-3 text-lg" href={l.href}>{l.label}</a></li>)}
      <li class="pt-3 pb-2"><BookingButton campaign={`menu-${campaign}`} class="w-full" /></li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    }),
  );
</script>
