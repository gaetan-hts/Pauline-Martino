---
// Rameau d'olivier, en attendant le logo définitif (cerveau + ramification d'olivier).
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg class={cls} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <path d="M8 42C16 32 24 22 40 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  <ellipse cx="17" cy="27" rx="7.5" ry="3" transform="rotate(-70 17 27)" fill="currentColor" opacity=".85" />
  <ellipse cx="22" cy="31" rx="7.5" ry="3" transform="rotate(10 22 31)" fill="currentColor" opacity=".55" />
  <ellipse cx="25" cy="18" rx="7" ry="2.8" transform="rotate(-80 25 18)" fill="currentColor" opacity=".7" />
  <ellipse cx="30" cy="22" rx="7" ry="2.8" transform="rotate(5 30 22)" fill="currentColor" opacity=".9" />
  <ellipse cx="34" cy="11" rx="6" ry="2.5" transform="rotate(-20 34 11)" fill="currentColor" opacity=".6" />
  <circle cx="12.5" cy="36" r="2.4" fill="#a14d2c" />
</svg>
