---
import { bookingUrl } from '../data/site';
interface Props { campaign: string; label?: string; class?: string }
const { campaign, label = 'Prendre rendez-vous', class: cls = '' } = Astro.props;
---
<a class:list={['btn btn-rdv', cls]} href={bookingUrl(campaign)} target="_blank" rel="noopener">
  {label}
  <span class="sr-only"> (ouvre Medoucine dans un nouvel onglet)</span>
</a>
