---
interface Props { text: string; author: string; tone?: 'sombre' | 'clair' }
const { text, author, tone = 'sombre' } = Astro.props;
---
<figure class:list={[
  'py-16 sm:py-24',
  tone === 'sombre' ? 'bg-saumon text-encre' : 'bg-sable text-encre',
]}>
  <div class="wrap max-w-4xl text-center">
    <blockquote class="font-serif text-2xl leading-snug sm:text-[2.1rem]">
      <p>« {text} »</p>
    </blockquote>
    <figcaption class:list={['mt-6 text-base', 'text-cuivre']}>
      {author}
    </figcaption>
  </div>
</figure>
