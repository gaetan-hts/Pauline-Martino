---
// Liens réseaux sociaux en icônes (Instagram, Facebook, LinkedIn), libellés pour les lecteurs d'écran.
import { site } from '../data/site';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const links = [
  {
    label: 'Instagram',
    href: site.social.instagram,
    // contour d'appareil photo arrondi + objectif + point
    icon: '<rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/>',
  },
  {
    label: 'Facebook',
    href: site.social.facebook,
    icon: '<path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10.5H8v3h2.5V21z"/>',
  },
  {
    label: 'LinkedIn',
    href: site.social.linkedin,
    icon: '<path fill="currentColor" d="M4.5 8.8h3.3V20H4.5zM6.2 3.5a1.9 1.9 0 1 1 0 3.8 1.9 1.9 0 0 1 0-3.8zM10 8.8h3.2v1.5h.1c.4-.8 1.5-1.8 3.2-1.8 3.4 0 4 2.2 4 5.1V20h-3.3v-5.6c0-1.3 0-3-1.9-3s-2.1 1.4-2.1 2.9V20H10z"/>',
  },
];
---
<ul class:list={['flex gap-3', cls]}>
  {links.map((l) => (
    <li>
      <a href={l.href} target="_blank" rel="noopener" class="grid h-11 w-11 place-items-center rounded-full border border-brun/25 transition-colors hover:border-pivoine hover:text-pivoine" aria-label={`${l.label} (nouvel onglet)`} title={l.label}>
        <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true" set:html={l.icon} />
      </a>
    </li>
  ))}
</ul>
