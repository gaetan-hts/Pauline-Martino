---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { getImage } from 'astro:assets';
import ogDefault from '../assets/photos/pauline-portrait.jpg';
import { ui } from '../i18n/ui';
import { englishEnabled, ogLocale, type Alternates, type Lang } from '../i18n/config';

interface Props {
  lang?: Lang;
  alternates?: Alternates; // URL de la page dans chaque langue (hreflang + sélecteur de langue)
  title: string;
  description: string;
  campaign: string; // identifiant de page pour le suivi des clics « Prendre rendez-vous »
  jsonLd?: Record<string, unknown>[];
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  noindex?: boolean; // page 404
}
const {
  lang = 'fr',
  alternates: alternatesProp,
  title,
  description,
  campaign,
  jsonLd = [],
  ogImage = ogDefault,
  ogImageAlt = lang === 'fr'
    ? 'Portrait de Pauline Martino, hypnothérapeute à La Farlède'
    : 'Portrait of Pauline Martino, hypnotherapist in La Farlède',
  noindex = false,
} = Astro.props;
const alternates = englishEnabled ? alternatesProp : undefined;
const canonical = new URL(Astro.url.pathname, site.url).href;
const abs = (path: string) => new URL(path, site.url).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, site.url).href;

// Fiche « entreprise locale » commune à toutes les pages (adresse, horaires, téléphone)
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site.url}/#cabinet`,
  name: 'Pauline Martino, hypnothérapeute',
  description: 'Hypnose, NEMO-EMDR et PNL à La Farlède, à 15 minutes de Toulon, et en visio.',
  url: site.url,
  telephone: '+33605532143',
  email: site.email,
  image: ogUrl,
  priceRange: site.price,
  currenciesAccepted: 'EUR',
  paymentAccepted: 'Virement, carte bancaire, chèque, espèces',
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapsUrl,
  knowsLanguage: 'fr',
  makesOffer: {
    '@type': 'Offer',
    name: 'Séance d’hypnose, de PNL ou de NEMO (1 heure), au cabinet ou en visio',
    price: site.priceValue,
    priceCurrency: 'EUR',
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  areaServed: [site.address.city, ...site.neighbours].map((name) => ({ '@type': 'City', name })),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Wednesday', 'Saturday'], opens: '09:00', closes: '19:00' },
  ],
  sameAs: Object.values(site.social),
  founder: { '@type': 'Person', name: 'Pauline Martino', jobTitle: site.job },
};
const schemas = [business, ...jsonLd];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#faf5ef" />
    {!noindex && alternates && (
      <>
        <link rel="alternate" hreflang="fr" href={abs(alternates.fr)} />
        <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
        <link rel="alternate" hreflang="x-default" href={abs(alternates.fr)} />
      </>
    )}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates && <meta property="og:locale:alternate" content={ogLocale[lang === 'fr' ? 'en' : 'fr']} />}
    <meta property="og:site_name" content="Pauline Martino, hypnothérapeute" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2">{ui[lang].skip}</a>
    <Header lang={lang} campaign={campaign} alternates={alternates} />
    <main id="contenu"><slot /></main>
    <Footer lang={lang} alternates={alternates} />
  </body>
</html>
